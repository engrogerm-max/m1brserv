{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile with role details",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["client", "provider", "admin"] },
        "phone": { "type": "string", "maxLength": 20 }
      },
      "required": ["id", "name", "role"]
    },
    "ClientProfile": {
      "title": "Client Profile",
      "description": "Client profile registration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "cpf": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "ProviderProfile": {
      "title": "Provider Profile",
      "description": "Service provider profile registration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "ServiceRequest": {
      "title": "Service Request",
      "description": "A service order with negotiations, budget, and chat logs",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "maxLength": 12 },
        "title": { "type": "string", "maxLength": 150 },
        "status": { "type": "string" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "providerId": { "type": "string" },
        "providerChatReleased": { "type": "boolean" },
        "estimatedPrice": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "code", "title", "status", "clientId"]
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "A single chat message linked to a service request",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "serviceId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderId": { "type": "string" },
        "senderRole": { "type": "string", "enum": ["client", "provider", "admin", "system"] },
        "senderName": { "type": "string", "maxLength": 100 },
        "text": { "type": "string", "maxLength": 5000 },
        "mediaUrl": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["serviceId", "senderRole", "text"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User accounts"
    },
    "/clients/{clientId}": {
      "schema": "ClientProfile",
      "description": "Client registrations"
    },
    "/providers/{providerId}": {
      "schema": "ProviderProfile",
      "description": "Service provider registrations"
    },
    "/services/{serviceId}": {
      "schema": "ServiceRequest",
      "description": "Service request and order documents"
    },
    "/chatMessages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Granular real-time chat messages"
    }
  }
}
